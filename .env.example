# Copy to .env.local for local work. On Vercel, add these under Settings > Environment Variables.
# Everything here ends up in the browser, so never put a secret key in this file.
VITE_HQ_NAME=
VITE_HQ_LOGO=
# The team's Zoom link. Opens when someone walks into the Collaboration Room.
VITE_MEETING_URL=
# Supabase (live multiplayer and sign-in). Without these the site runs in preview mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to false to skip the account screen so everyone enters as a guest.
VITE_REQUIRE_SIGNIN=
# Optional: a free Giphy API key turns the GIF button into a GIF search. Without it people paste a GIF link.
VITE_GIPHY_KEY=
